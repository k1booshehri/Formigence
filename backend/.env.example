# Copy to backend/.env and adjust. All values here are dev defaults.

# --- Application ---
ENVIRONMENT=development
DEBUG=true
# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# Async SQLAlchemy URL (asyncpg driver). Alembic derives its sync URL from this.
DATABASE_URL=postgresql+asyncpg://formigence:formigence@localhost:5432/formigence
# Separate database used by pytest. It is created/dropped by the test fixtures.
TEST_DATABASE_URL=postgresql+asyncpg://formigence:formigence@localhost:5432/formigence_test

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- Email ---
# console = write the OTP to the application log (dev only).
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@formigence.local

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
# slowapi limit strings, applied per IP and per email on the OTP endpoints.
OTP_REQUEST_RATE_LIMIT_PER_IP=10/hour
OTP_REQUEST_RATE_LIMIT_PER_EMAIL=5/hour
OTP_VERIFY_RATE_LIMIT_PER_IP=20/hour
OTP_VERIFY_RATE_LIMIT_PER_EMAIL=10/hour
# Stricter than the auth endpoints: each accepted submission costs an API call.
RESPONSE_SUBMIT_RATE_LIMIT_PER_IP=5/hour

# --- CAPTCHA (respondent submissions) ---
# Disabled in dev. When true, submissions must carry a valid captcha_token.
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
CAPTCHA_TIMEOUT_SECONDS=10

# --- Anthropic / analysis ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1000
ANTHROPIC_TIMEOUT_SECONDS=60
# Total attempts = 1 + ANALYSIS_MAX_RETRIES.
ANALYSIS_MAX_RETRIES=2
ANALYSIS_RETRY_BASE_DELAY_SECONDS=1.0
ANALYSIS_RETRY_MAX_DELAY_SECONDS=30.0

# --- Pagination ---
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100
