# Copy to backend/.env and adjust. All values here are dev defaults.

# --- Application ---
ENVIRONMENT=development
DEBUG=true
# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# Async SQLAlchemy URL (asyncpg driver). Alembic derives its sync URL from this.
DATABASE_URL=postgresql+asyncpg://formigence:formigence@localhost:5432/formigence
# Separate database used by pytest. It is created/dropped by the test fixtures.
TEST_DATABASE_URL=postgresql+asyncpg://formigence:formigence@localhost:5432/formigence_test

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- Email ---
# console = write the OTP to the application log (dev only).
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@formigence.local

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
# slowapi limit strings, applied per IP and per email on the OTP endpoints.
OTP_REQUEST_RATE_LIMIT_PER_IP=10/hour
OTP_REQUEST_RATE_LIMIT_PER_EMAIL=5/hour
OTP_VERIFY_RATE_LIMIT_PER_IP=20/hour
OTP_VERIFY_RATE_LIMIT_PER_EMAIL=10/hour
